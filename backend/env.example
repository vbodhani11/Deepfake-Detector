# Environment Configuration
ENVIRONMENT=local
PROJECT_NAME="Deepfake Detector API"

# Security
SECRET_KEY=your-secret-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=deepfake_user
POSTGRES_PASSWORD=changethis
POSTGRES_DB=deepfake_detector
POSTGRES_SSL_MODE=prefer

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Email Configuration (Optional)
SMTP_TLS=true
SMTP_SSL=false
SMTP_PORT=587
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=
EMAILS_FROM_NAME=

# Test Configuration
EMAIL_TEST_USER=test@example.com
FIRST_SUPERUSER=admin@deepfakedetector.com
FIRST_SUPERUSER_PASSWORD=changethis

# ML Model Configuration
MODEL_PATH=model/models/xception_best.pt
MAX_FILE_SIZE_MB=50
MAX_VIDEO_DURATION_SECONDS=10  # Limit video duration for memory efficiency
ALLOWED_VIDEO_EXTENSIONS=[".mp4",".avi",".mov",".mkv"]
ALLOWED_IMAGE_EXTENSIONS=[".jpg",".jpeg",".png",".bmp"]
DEFAULT_FPS=3
DEFAULT_THRESHOLD=0.5
# If real videos are detected as fake, set this to true to invert class mapping
INVERT_CLASS_MAPPING=false

# Memory Optimization Settings (for low-RAM VMs like 3.8GB)
# FP16 reduces memory by ~50% with minimal accuracy loss
USE_FP16=true
# Process crops in smaller batches to avoid OOM (default: 8)
INFERENCE_BATCH_SIZE=8
# INT8 quantization (optional, more memory savings but slight accuracy loss)
# USE_QUANTIZATION=false

# Optional: Monitoring
SENTRY_DSN=
